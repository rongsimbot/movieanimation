# MovieAnimation Backend Environment Variables
# Copy to backend/.env and fill in your values

# PostgreSQL (via SSH tunnel to RTX 3060 node)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sim_admin
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=movieanimation

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_generate_a_random_64_char_string
JWT_EXPIRES_IN=24h

# Server
PORT=3001
NODE_ENV=development

# Redis (for video generation job queue)
REDIS_URL=redis://127.0.0.1:6379

# ══════════════════════════════════════
# Phase 6: AI Video API Keys (Multi-Key Rotation)
# ══════════════════════════════════════
# Primary keys (required):
OPENAI_API_KEY=sk-your-openai-key-here       # Sora 2
RUNWAY_API_KEY=key_your-runway-key-here       # Runway Gen-4.5
SEEDANCE_API_KEY=your-seedance-key-here       # Seedance 2.0
LUMA_API_KEY=luma-your-luma-key-here          # Luma Dream Machine

# Optional: Rotation keys (add up to 5 per provider)
# OPENAI_API_KEY_2=sk-second-key
# OPENAI_API_KEY_3=sk-third-key
# RUNWAY_API_KEY_2=key_second
# SEEDANCE_API_KEY_2=second-seedance-key

# AI Script Parser
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ══════════════════════════════════════
# Phase 6: Webhook Configuration
# ══════════════════════════════════════
# WEBHOOK_STORE_PATH=./data/webhooks.json   # Default
# COST_LOG_PATH=./data/cost_log.jsonl        # Default
# KEY_STORE_PATH=./data/api_keys.json        # Default
