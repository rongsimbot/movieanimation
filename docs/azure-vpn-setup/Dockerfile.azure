# Dockerfile — MovieAnimation.ai Azure App Service + Tailscale VPN
# Build: docker build -f docs/azure-vpn-setup/Dockerfile.azure -t movieanimation-azure .
# Deploy: Push to Azure Container Registry or Docker Hub, then az webapp create

FROM node:20-slim

# ─── System Dependencies ─────────────────────────────────────
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    iptables \
    && rm -rf /var/lib/apt/lists/*

# ─── Install Tailscale ───────────────────────────────────────
# Uses official install script; runs in userspace mode in containers
RUN curl -fsSL https://tailscale.com/install.sh | sh

# ─── Build Next.js App ───────────────────────────────────────
WORKDIR /app

# Copy dependency files first (layer caching)
COPY package*.json ./
RUN npm ci --production=false

# Copy source and build
COPY . .
RUN npm run build

# Keep only production deps
RUN npm prune --production

# ─── Copy Startup Script ─────────────────────────────────────
# The startup script lives alongside this Dockerfile
COPY docs/azure-vpn-setup/startup.sh /app/start.sh
RUN chmod +x /app/start.sh

# ─── App Service Config ──────────────────────────────────────
# Azure App Service requires port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

# ─── Entrypoint ──────────────────────────────────────────────
CMD ["/app/start.sh"]
