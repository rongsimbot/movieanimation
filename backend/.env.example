# MovieAnimation Backend Environment Variables
# Copy to .env and fill in your values

# PostgreSQL Database (via SSH tunnel)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sim_admin
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=movieanimation

# JWT Authentication
# Generate: openssl rand -base64 64
JWT_SECRET=generate_a_secure_random_string_here
JWT_EXPIRES_IN=24h

# Redis (Job Queue)
REDIS_URL=redis://127.0.0.1:6379

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id

# ─── API Keys (Video Generation Providers) ─────────────────────────

LUMA_API_KEY=your_luma_key
ANTHROPIC_API_KEY=your_anthropic_key
RUNWAY_API_KEY=your_runway_key

# ─── OAuth Providers (Optional) ────────────────────────────────────

# Google OAuth 2.0
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: {FRONTEND_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# GitHub OAuth App
# 1. Go to https://github.com/settings/developers
# 2. Create OAuth App
# 3. Add callback URL: {FRONTEND_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/oauth/github/callback

# ─── Email (for verification & password reset) ─────────────────────

# SMTP for sending emails (uses nodemailer)
# If not configured, tokens are returned in API responses (dev mode only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@movieanimation.ai
